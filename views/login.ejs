<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login | BLOODLink</title><link rel="stylesheet" href="/css/styles.css"></head>
<body class="auth"><div class="hero"><h2>🩸 BLOODLink</h2><h1>Every Drop<br>Can Save a Life</h1><p>Join our community of lifesavers and make a difference.</p></div>
<form class="card" method="post" action="/login"><h2>Welcome Back!</h2><p>Log in to your account to continue.</p>
<% if(err){ %><p class="msg"><%= err %></p><% } %><% if(ok){ %><p class="msg ok"><%= ok %></p><% } %>
<label>Email or Phone Number<input name="email" required></label>
<label>Password<input type="password" name="password" required></label>
<button>Log In</button><p class="c">Don't have an account? <a href="/signup">Sign Up</a></p></form></body></html>
