<%- include('partials/header',{title:'Find a Donor'}) %>
<form class="bar"><input name="term" value="<%= term %>" placeholder="Search by name or location">
<select name="bg"><option value="">All groups</option><% G.forEach(g=>{ %><option <%= g===bg?'selected':'' %>><%= g %></option><% }) %></select><button>Search</button></form>
<h3>Available Donors</h3><% donors.forEach(d=>{ %><p class="row"><b><%= d.full_name %></b> <span class="b Completed"><%= d.blood_group %></span> <small><%= d.address||'' %></small></p><% }) %>
<% if(!donors.length){ %><p>No donors match your search. Try a different blood group.</p><% } %>
<%- include('partials/footer') %>
